# ─────────────────────────────────────────────────────────────
# CognoDB / Neo4j connection details
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# CognoDB Cloud gives you a URI of this exact shape:
#   bolt+s://<instance-id>.databases.cognodb.cloud
# For a LOCAL Neo4j (docker) use: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687

# CognoDB's default username is "cognodb". Local Neo4j default is "neo4j".
NEO4J_USERNAME=neo4j

# The password is shown by CognoDB exactly ONCE at instance creation — save it.
NEO4J_PASSWORD=testpassword123

# Optional: database name (CognoDB / Neo4j default is "neo4j")
NEO4J_DATABASE=neo4j
